# Kredensial Supabase Anda
# Dapatkan dari Project Settings > API di dashboard Supabase (https://app.supabase.com)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Pembatasan Akses Admin (Google OAuth & Email Login)
# Masukkan email yang berhak menjadi admin, pisahkan dengan koma jika lebih dari satu
# Contoh: admin@antarapsychology.com,fadhil@gmail.com
VITE_ALLOWED_ADMIN_EMAILS=admin@antarapsychology.com
